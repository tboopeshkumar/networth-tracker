# Copy to .env.local for local development (never committed).
# For the live site, set the same names under GitHub → Settings →
# Secrets and variables → Actions → Variables.
#
# Every value here ends up inside the published JavaScript. That's fine: the
# Google values are public by design, and emails are stored only as hashes.

VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIza...
VITE_GOOGLE_APP_ID=1234567890

# npm run hash-email -- you@gmail.com   (comma-separate several)
# Who may use the app. Leave empty to rely only on Google's test-user list.
VITE_ALLOWED_EMAIL_HASHES=
# Who sees Edit/Add. Leave empty to let every allowed account edit.
# Not a security control: share the sheet as Viewer to actually block writes.
VITE_EDITOR_EMAIL_HASHES=

VITE_IDLE_MINUTES=20
